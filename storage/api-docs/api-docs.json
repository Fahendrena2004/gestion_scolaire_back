{
    "openapi": "3.0.0",
    "info": {
        "title": "Gestion Sco API",
        "description": "Documentation API Laravel - Auth session-based",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Serveur local"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion utilisateur",
                "description": "Connexion et création de session Laravel",
                "operationId": "fd38eab35a3cc28d00ada587f6955506",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "test@mail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Connexion réussie"
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "nom": {
                                                    "type": "string"
                                                },
                                                "prenom": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "session_id": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Erreur authentification"
                    },
                    "422": {
                        "description": "Erreur validation"
                    }
                }
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Inscription utilisateur",
                "description": "Créer un nouvel utilisateur",
                "operationId": "5e9dd82c858753ad481f146678e34951",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "prenom",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string"
                                    },
                                    "prenom": {
                                        "type": "string"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "password_confirmation": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Utilisateur créé",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur validation"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Déconnexion utilisateur",
                "description": "Suppression de la session utilisateur",
                "operationId": "d2f0239468d539b07f33e62fab239518",
                "responses": {
                    "200": {
                        "description": "Déconnexion réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Déconnexion réussie"
                                        },
                                        "data": {
                                            "properties": {
                                                "user_id": {
                                                    "type": "integer"
                                                },
                                                "user_email": {
                                                    "type": "string"
                                                },
                                                "session_id": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erreur serveur"
                    }
                }
            }
        },
        "/api/inscription/cycles": {
            "get": {
                "tags": [
                    "Cycles"
                ],
                "summary": "Récupérer tous les cycles",
                "description": "Retourne la liste des cycles disponibles (primaire, college, lycee)",
                "operationId": "6e3ccfcbd260bfa2e8cb060441819f1e",
                "responses": {
                    "200": {
                        "description": "Succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "example": [
                                                "primaire",
                                                "college",
                                                "lycee"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/inscription/niveaux/{cycle}": {
            "get": {
                "tags": [
                    "Cycles"
                ],
                "summary": "Récupérer les niveaux par cycle",
                "description": "Retourne la liste des niveaux pour un cycle donné",
                "operationId": "53b6af537340066337b1328bc344acfa",
                "parameters": [
                    {
                        "name": "cycle",
                        "in": "path",
                        "description": "Cycle (primaire, college, lycee)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "college"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 6
                                                    },
                                                    "nom_niveau": {
                                                        "type": "string",
                                                        "example": "6ème"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Cycle non trouvé"
                    }
                }
            }
        },
        "/api/inscription/classes/{niveauId}": {
            "get": {
                "tags": [
                    "Cycles"
                ],
                "summary": "Récupérer les classes par niveau",
                "description": "Retourne la liste des classes pour un niveau donné",
                "operationId": "0ed8b9b6ed9452e38a451e94cf5e2589",
                "parameters": [
                    {
                        "name": "niveauId",
                        "in": "path",
                        "description": "ID du niveau",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 6
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 12
                                                    },
                                                    "nom_classe": {
                                                        "type": "string",
                                                        "example": "6ème A"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Niveau non trouvé"
                    }
                }
            }
        },
        "/api/inscription/frais/calcul": {
            "get": {
                "tags": [
                    "Frais"
                ],
                "summary": "Calculer les frais de scolarité",
                "description": "Calcule le montant total des frais selon le cycle et les options",
                "operationId": "1140abbd31df2c70694a4e00dbb81fca",
                "parameters": [
                    {
                        "name": "cycle",
                        "in": "query",
                        "description": "Cycle (primaire, college, lycee)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "college"
                        }
                    },
                    {
                        "name": "parascolaire",
                        "in": "query",
                        "description": "Option parascolaire",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": true
                        }
                    },
                    {
                        "name": "cantine",
                        "in": "query",
                        "description": "Option cantine",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "total": {
                                                    "type": "integer",
                                                    "example": 540000
                                                },
                                                "details": {
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "libelle": {
                                                                "type": "string",
                                                                "example": "Inscription"
                                                            },
                                                            "montant": {
                                                                "type": "integer",
                                                                "example": 75000
                                                            },
                                                            "type": {
                                                                "type": "string",
                                                                "example": "obligatoire"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/inscription": {
            "post": {
                "tags": [
                    "Inscription"
                ],
                "summary": "Soumettre une inscription",
                "description": "Enregistre une nouvelle inscription",
                "operationId": "4d2845a261a77b4604b5efc0d94c9dad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "prenom",
                                    "date_naissance",
                                    "lieu_naissance",
                                    "sexe",
                                    "cycle",
                                    "niveau_id",
                                    "classe_id"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Rakoto"
                                    },
                                    "prenom": {
                                        "type": "string",
                                        "example": "Fara"
                                    },
                                    "date_naissance": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2015-03-20"
                                    },
                                    "lieu_naissance": {
                                        "type": "string",
                                        "example": "Antananarivo"
                                    },
                                    "sexe": {
                                        "type": "string",
                                        "example": "F",
                                        "enum": [
                                            "M",
                                            "F"
                                        ]
                                    },
                                    "adresse": {
                                        "type": "string",
                                        "example": "Lot IV 123 Bis",
                                        "nullable": true
                                    },
                                    "cycle": {
                                        "type": "string",
                                        "example": "college",
                                        "enum": [
                                            "primaire",
                                            "college",
                                            "lycee"
                                        ]
                                    },
                                    "niveau_id": {
                                        "type": "integer",
                                        "example": 6
                                    },
                                    "classe_id": {
                                        "type": "integer",
                                        "example": 12
                                    },
                                    "parascolaire": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "cantine": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "montant_verse": {
                                        "type": "integer",
                                        "example": 200000
                                    },
                                    "responsable_nom": {
                                        "type": "string",
                                        "example": "Rakoto Jean"
                                    },
                                    "responsable_telephone": {
                                        "type": "string",
                                        "example": "0321234567"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Inscription réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Inscription réussie"
                                        },
                                        "data": {
                                            "properties": {
                                                "matricule": {
                                                    "type": "string",
                                                    "example": "RG-CL-2025-0001"
                                                },
                                                "eleve_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "inscription_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "classe": {
                                                    "type": "string",
                                                    "example": "6ème B"
                                                },
                                                "niveau": {
                                                    "type": "string",
                                                    "example": "6ème"
                                                },
                                                "cycle": {
                                                    "type": "string",
                                                    "example": "college"
                                                },
                                                "annee_scolaire": {
                                                    "type": "string",
                                                    "example": "2025-09-01 - 2026-06-30"
                                                },
                                                "montant_total": {
                                                    "type": "integer",
                                                    "example": 540000
                                                },
                                                "montant_verse": {
                                                    "type": "integer",
                                                    "example": 200000
                                                },
                                                "reste_a_payer": {
                                                    "type": "integer",
                                                    "example": 340000
                                                },
                                                "est_paye": {
                                                    "type": "boolean",
                                                    "example": false
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Erreur de validation"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erreur serveur",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Erreur lors de l'inscription"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/inscription/{id}": {
            "get": {
                "tags": [
                    "Inscription"
                ],
                "summary": "Détails d'une inscription",
                "description": "Retourne tous les détails d'une inscription",
                "operationId": "2a6fcd188fe341b9eb4ef919c9185202",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID de l'inscription",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "date_inscription": {
                                                    "type": "string"
                                                },
                                                "eleve": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer"
                                                        },
                                                        "nom": {
                                                            "type": "string"
                                                        },
                                                        "prenom": {
                                                            "type": "string"
                                                        },
                                                        "matricule": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "classe": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer"
                                                        },
                                                        "nom": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "montant_total": {
                                                    "type": "integer"
                                                },
                                                "reste_a_payer": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Inscription non trouvée"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Cycles",
            "description": "Cycles"
        },
        {
            "name": "Frais",
            "description": "Frais"
        },
        {
            "name": "Inscription",
            "description": "Inscription"
        }
    ]
}